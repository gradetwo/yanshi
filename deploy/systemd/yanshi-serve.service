[Unit]
Description=偃师 Yanshi 无头渲染服务端（HTTP/WebSocket，回环 8110）
Documentation=file:///home/crow/yanshi/README.md
After=network.target

[Service]
Type=simple
# 只监听回环：capability token 之外不暴露到局域网。
ExecStart=%h/yanshi/target/release/yanshi-serve --bind 127.0.0.1:8110 --root %h/.local/share/yanshi/workspace --doc yanshi --width 1024 --height 1024
WorkingDirectory=%h/yanshi
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
# 服务端是 headless 的，不需要图形/会话环境变量。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yanshi-serve

[Install]
WantedBy=default.target
